<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Futuristic Linear Search Scanner</title>
  <style>
    /* Reset & Deep Space Background */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: radial-gradient(circle at 50% 50%, #0a0b10 0%, #020204 100%);
      color: #ffffff;
      font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      overflow: hidden;
    }

    /* Ambient Nebulae */
    .laser-glow {
      position: absolute;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(239, 68, 68, 0.08) 0%, transparent 70%);
      top: -20%;
      left: 20%;
      z-index: 1;
      pointer-events: none;
    }

    /* Main Dashboard Container */
    .dashboard {
      position: relative;
      z-index: 10;
      background: rgba(13, 15, 24, 0.7);
      backdrop-filter: blur(30px);
      -webkit-backdrop-filter: blur(30px);
      border: 1px solid rgba(255, 255, 255, 0.06);
      padding: 40px;
      border-radius: 28px;
      box-shadow: 0 40px 80px rgba(0, 0, 0, 0.8);
      width: 90%;
      max-width: 750px;
    }

    h1 {
      font-size: 1.6rem;
      font-weight: 800;
      letter-spacing: 3px;
      text-transform: uppercase;
      background: linear-gradient(45deg, #ff007f, #7928ca);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 5px;
      text-align: center;
    }

    .status-text {
      color: rgba(255, 255, 255, 0.4);
      font-size: 0.85rem;
      text-align: center;
      margin-bottom: 35px;
      letter-spacing: 1px;
      font-family: monospace;
    }

    /* Grid Area untuk Kotak Node Data */
    .node-grid {
      display: flex;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
      gap: 15px;
      margin-bottom: 40px;
      min-height: 90px;
    }

    /* Desain Kotak Memori Tunggal */
    .node {
      width: 65px;
      height: 65px;
      background: rgba(121, 40, 202, 0.1);
      border: 2px solid rgba(121, 40, 202, 0.3);
      border-radius: 14px;
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: 'Courier New', monospace;
      font-size: 1.3rem;
      font-weight: bold;
      color: rgba(255, 255, 255, 0.8);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: inset 0 0 10px rgba(121, 40, 202, 0.1);
    }

    /* Efek Animasi State Scanner */
    .node.scanning {
      background: rgba(255, 183, 3, 0.15);
      border-color: #ffb703;
      color: #ffb703;
      transform: scale(1.12);
      box-shadow: 0 0 25px rgba(255, 183, 3, 0.5), inset 0 0 15px rgba(255, 183, 3, 0.2);
    }

    .node.wrong {
      background: rgba(239, 68, 68, 0.05);
      border-color: rgba(239, 68, 68, 0.4);
      color: rgba(239, 68, 68, 0.4);
      transform: scale(0.95);
    }

    .node.found {
      background: rgba(0, 245, 212, 0.2);
      border-color: #00f5d4;
      color: #00f5d4;
      transform: scale(1.15);
      box-shadow: 0 0 35px rgba(0, 245, 212, 0.6);
      animation: glitch 0.3s infinite alternate;
    }

    /* Kontrol Panel Penyetelan Input */
    .control-panel {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.05);
      padding: 20px;
      border-radius: 18px;
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    .input-group {
      display: flex;
      gap: 10px;
    }

    input {
      flex: 1;
      background: rgba(0, 0, 0, 0.4);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 10px;
      padding: 12px 15px;
      color: #ffffff;
      font-size: 1rem;
      font-family: monospace;
      outline: none;
      transition: all 0.3s;
    }

    input:focus {
      border-color: #ff007f;
      box-shadow: 0 0 15px rgba(255, 0, 127, 0.2);
    }

    /* Tombol Navigasi */
    button {
      background: transparent;
      color: #ffffff;
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 12px 24px;
      border-radius: 10px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    button.btn-scan {
      background: linear-gradient(45deg, #ff007f, #7928ca);
      border: none;
      box-shadow: 0 4px 20px rgba(255, 0, 127, 0.3);
    }

    button:hover:not(:disabled) {
      background: rgba(255, 255, 255, 0.05);
      transform: translateY(-1px);
    }

    button.btn-scan:hover:not(:disabled) {
      background: linear-gradient(45deg, #ff2a93, #8b3fd6);
      box-shadow: 0 6px 25px rgba(255, 0, 127, 0.5);
    }

    button:disabled {
      opacity: 0.25;
      cursor: not-allowed;
    }

    @keyframes glitch {
      0% { transform: scale(1.15) translateY(0); }
      100% { transform: scale(1.15) translateY(-2px); }
    }
  </style>
</head>
<body>

  <div class="laser-glow"></div>

  <div class="dashboard">
    <h1>Linear Search Core</h1>
    <div class="status-text" id="statusLog">SISTEM: Siap melakukan pemindaian data</div>

    <!-- Kotak Pemindaian Element -->
    <div class="node-grid" id="gridBox"></div>

    <!-- Sistem Kontrol Masukan -->
    <div class="control-panel">
      <div class="input-group">
        <input type="number" id="inputTarget" placeholder="Masukkan angka target (10 - 99)" min="10" max="99">
        <button class="btn-scan" onclick="mulaiPencarian()" id="btnStart">Cari Angka</button>
      </div>
      <div style="display: flex; gap: 10px; justify-content: center;">
        <button onclick="acakUlangData()" id="btnShuffle" style="width: 50%;">Acak Database</button>
      </div>
    </div>
  </div>

  <script>
    const gridBox = document.getElementById("gridBox");
    const statusLog = document.getElementById("statusLog");
    
    // Array data default awal
    let database = [23, 87, 42, 15, 68, 91, 54, 37];
    let nodeElements = [];

    // Menggambar kotak-kotak array ke UI
    function renderGrid() {
      gridBox.innerHTML = "";
      nodeElements = [];
      database.forEach(angka => {
        const node = document.createElement("div");
        node.classList.add("node");
        node.innerText = angka;
        gridBox.appendChild(node);
        nodeElements.push(node);
      });
    }

    // Fungsi delay animasi
    function jeda(ms) {
      return new Promise(resolve => setTimeout(resolve, ms));
    }

    function acakUlangData() {
      database = Array.from({ length: 8 }, () => Math.floor(Math.random() * 89) + 10);
      renderGrid();
      statusLog.innerText = "SISTEM: Database berhasil diacak ulang.";
      statusLog.style.color = "rgba(255, 255, 255, 0.4)";
    }

    // Alur Utama Algoritma Linear Search dengan Animasi Laser
    async function mulaiPencarian() {
      const inputField = document.getElementById("inputTarget");
      const target = parseInt(inputField.value);

      // Validasi input kosong
      if (isNaN(target)) {
        statusLog.innerText = "SISTEM ERROR: Harap masukkan angka target terlebih dahulu!";
        statusLog.style.color = "#ff4444";
        return;
      }

      // Reset style kelas sebelum scanning baru dimulai
      renderGrid();
      setInteraktivitas(false);

      let ketemu = false;

      // Perulangan Linear Search (Mengecek satu per satu dari indeks 0 sampai akhir)
      for (let i = 0; i < database.length; i++) {
        statusLog.innerText = `SISTEM: Memindai indeks ke-${i} (Nilai: ${database[i]})...`;
        statusLog.style.color = "#ffb703";
        
        nodeElements[i].classList.add("scanning");
        await jeda(600); // Kecepatan sensor membaca data (0.6 detik)

        if (database[i] === target) {
          // Jika angka di database COCOK dengan target input
          nodeElements[i].classList.remove("scanning");
          nodeElements[i].classList.add("found");
          statusLog.innerText = `SUCCESS: Target ${target} DITEMUKAN di indeks ke-${i}!`;
          statusLog.style.color = "#00f5d4";
          ketemu = true;
          break; // Stop perulangan karena target sudah didapatkan
        } else {
          // Jika angka tidak cocok
          nodeElements[i].classList.remove("scanning");
          nodeElements[i].classList.add("wrong");
        }
      }

      // Jika seluruh isi array sudah dilewati dan tidak ada yang cocok
      if (!ketemu) {
        statusLog.innerText = `SISTEM DATA: Target ${target} TIDAK DITEMUKAN di seluruh sektor memori.`;
        statusLog.style.color = "#ef4444";
      }

      setInteraktivitas(true);
    }

    function setInteraktivitas(kondisi) {
      document.getElementById("btnStart").disabled = !kondisi;
      document.getElementById("btnShuffle").disabled = !kondisi;
      document.getElementById("inputTarget").disabled = !kondisi;
    }

    // Inisialisasi tampilan pertama kali
    renderGrid();
  </script>

</body>
</html>
